{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Missing Required Parameters Response",
  "description": "Схема ответа при отсутствии обязательных параметров",
  "type": "object",
  "required": ["success", "error"],
  "properties": {
    "success": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  }
}